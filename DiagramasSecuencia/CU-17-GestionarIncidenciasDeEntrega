@startuml
title TurbineH - Gestionar incidencia de entrega

actor Administrador as Admin
actor Cliente
participant "Incidencia" as Incidencia

Admin -> Admin: consultar incidencias de la factura rectificada
alt #pink hay incidencia sin resolver
    Admin -> Cliente: entrega manual de la factura rectificada
    Admin -> Incidencia: resolver()
    Incidencia --> Admin: void
else #lightgreen no hay incidencias pendientes
    Admin --> Admin: sin resultados
end
@enduml
