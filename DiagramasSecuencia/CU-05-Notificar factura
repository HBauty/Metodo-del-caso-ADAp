@startuml
hide footbox
skinparam sequenceParticipant underline

actor ": Reloj del sistema /  Admin " as reloj
participant ": DataBase" as db <<infra>>
participant ": Factura" as fac
participant ": ServicioEmail" as email <<infra>>
participant ": Notificación" as notif
actor ": Cliente" as cli

reloj -> db : 1: RevisionDiariaVencimientos()
activate db
db --> reloj : facturas pendientes y configuración de recordatorios
deactivate db

loop #LightGreen Por cada factura con recordatorio programado y habilitado

    reloj -> email : 2: GenerarAviso(factura, tono, idioma)
    email --> reloj : aviso

    reloj -> fac : 3: enviarPorEmail()
    activate fac
    fac -> email : 4: EnviarAvisoCliente(datosContacto, aviso)
    email ->> cli : 5: EnviarNotificacionImpago(aviso)
    fac --> reloj : Boolean
    deactivate fac


    create notif
    reloj --> notif : 6: crear(tipo, texto)

    alt #Pink Entrega fallida
        reloj -> fac : 7: registrarIncidenciaEntrega()
    end

    reloj -> db : 8: ProgramarSiguienteAviso(idFactura)
end

@enduml
