
@startuml
title CU-07: Registrar ficha de suscripción (Acuerdo Comercial)

actor "Administrador" as admin

participant ":Cliente" as client
participant ":Suscripción" as sus
participant ":Documento" as doc

admin -> client : 1. consultarCliente(Cliente)
activate client
client --> admin : Cliente
deactivate client

admin --> sus : 2. crearSuscripcion
activate sus
sus --> admin : suscripcion Creada

admin --> sus : 3. solicitarAprobación

alt #Pink Suscripción denegada 
    sus --> admin : suscripción denegada
    admin -> sus : 5. pausar(motivo, inicio, retorno)
    sus -> admin : suscripción pausada

else #LightGreen Suscripción aprobada
    sus --> admin : suscripción aprobada

admin --> doc : 6. crearDocumento
activate doc
doc --> sus : Documento creado
deactivate doc 

end

deactivate sus

@enduml
