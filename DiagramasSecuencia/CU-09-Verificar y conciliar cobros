@startuml

title CU-09: Verificar y conciliar cobros

actor "Reloj del sistema" as reloj
actor "Administrador / Lector asignado" as admin

participant ":MovimientoPago" as pago
participant ":Factura" as factura
participant ":Incidencia" as incidencia
participant ":Notificación" as notificacion

reloj -> pago : 1. conectarPasarela()
activate pago
pago --> reloj : Movimientos obtenidos

loop Por cada movimiento recibido

    pago --> factura : 2. buscarFactura
    activate factura
    factura --> pago : Factura asociada

    pago -> pago : 3. compararImporte()
    
    alt Importe coincidente
        pago --> factura : Pago completo confirmado
        factura -> factura : actualizarEstadoCobro()
        factura -> factura : pausarSeguimiento(motivo, fecha)
        factura --> pago : Factura pagada

        pago --> notificacion : 4. crearNotificacion
        activate notificacion 
        notificacion --> admin : Notificación enviada
        deactivate notificacion 

    else Discrepancia en el importe (2a)
        pago --> factura : Importe diferente
        factura -> factura : actualizarEstadoCobro()
        factura --> pago : Diferencia pendiente

        pago -> incidencia : 5. registrarIncidenciaEntrega()
        activate incidencia
        incidencia --> pago : Incidencia registrada
        deactivate incidencia

        pago --> notificacion : 6. crearNotificacion
        activate notificacion 
        notificacion --> admin : Notificación enviada
        deactivate notificacion 

        admin -> pago : 7.revisarDiferenciaPago(Factura)
    end

    deactivate factura

end

deactivate pago

@enduml