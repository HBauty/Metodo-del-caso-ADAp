@startuml
title CU-11: Modificar factura en borrador
autonumber

actor "Administrador / Superadministrador (persona)" as persona
participant ":Administrador" as admin
participant ":Factura" as factura
participant ":Documento" as doc

persona -> admin : aprobarFactura(Factura)
activate admin
admin -> factura : calcular()
activate factura

alt #LightGreen estadoFactura = BORRADOR
    factura --> admin : importes recalculados
    factura -> factura : generarPdfEstandar()
    create doc
    factura --> doc : crear Documento (PDF definitivo)
    factura -> factura : enviarPorEmail()
    factura -> factura : actualizarEstadoCobro()
    factura --> admin : cambios guardadosfactura emitida
    admin --> persona : factura actualizada y emitida
else #Pink estadoFactura = EMITIDA (extensión 1a)
    factura --> admin : modificación bloqueada
    admin --> persona : debe generarse una factura rectificativa (CU-12)
end
deactivate factura
deactivate admin
@enduml
