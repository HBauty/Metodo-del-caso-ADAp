@startuml

title CU-10: Generar factura manual (Puntual)

actor "Lector asignado" as actor

participant ":Cliente" as cliente
participant ":Factura" as factura

actor -> cliente : 1. consultarCliente(Cliente)
cliente --> actor : Datos del cliente

actor -> factura : 2. crearFacturaManual(Factura)
activate factura

factura -> factura : 3. calcular()

    factura -> factura : 4. generarPdfEstandar()

    factura -> factura : 5. enviarPorEmail()
    factura --> actor : Confirmación de envío
    factura -> factura : 6. actualizarEstadoCobro()

    deactivate factura

deactivate factura

@enduml

