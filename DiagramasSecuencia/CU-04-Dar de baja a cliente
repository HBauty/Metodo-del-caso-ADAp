@startuml
hide footbox
skinparam sequenceParticipant underline

actor ": Lector asignado" as act
participant ": Interfaz" as ui <<boundary>>
participant ": DataBase" as db <<infra>>
participant ": Cliente" as cli
participant ": Suscripción" as sub
participant ": Notificación" as notif
participant ": ServicioEmail" as email <<infra>>

act -> ui : 1: SolicitarBajaCliente(idCliente)
activate ui

ui -> db : 2: ObtenerCliente(idCliente)
activate db
create cli
db --> cli : 3: cargar datos (incluye su suscripción)
db --> ui : cliente
deactivate db

ui -> sub : 4: cancelar(fecha)
activate sub
note right of sub
  Suscripción de cliente.suscripción.
  Se detiene la facturación recurrente
  en cualquier caso.
end note
sub --> ui : True
deactivate sub

ui -> db : 5: ComprobarFacturasPendientes(idCliente)
activate db

alt #LightGreen Sin facturas pendientes ni vencidas (Escenario de éxito)
    db --> ui : False (Sin deudas)
    deactivate db

    ui -> cli : 6: tramitarBaja()
    activate cli
    note right of cli
      estadoFicha = BAJA_LÓGICA
    end note
    cli --> ui : True
    deactivate cli

    ui -> db : 7: GuardarEstadoCliente(cli)
    activate db
    db --> ui : True
    deactivate db

    ui --> act : ConfirmarBajaCliente()

else #Pink 3a. El cliente tiene impagos pendientes (Termina la secuencia)
    db --> ui : True (Con deudas pendientes)
    deactivate db

    note over cli
      No se llama a tramitarBaja():
      la suscripción queda cancelada pero la ficha
      no pasa a BAJA_LÓGICA hasta liquidar la deuda.
    end note

    ui -> db : 8: GuardarEstadoCliente(cli)
    activate db
    db --> ui : True
    deactivate db

    create notif
    ui --> notif : 9: crear(tipo = deuda pendiente, texto)

    ui ->> email : 10: enviarNotificacionDeudaPendiente(datosContacto, notificacion)

    ui --> act : InformarBajaPendienteDeLiquidacionPorImpagos()
end

deactivate ui
@enduml
