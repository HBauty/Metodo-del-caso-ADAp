
@startuml CU12_Emitirfactura

actor "Administrador / Lector" as Usuario

participant ":Lector" as lector
participant ":Cliente" as client
participant ":Suscripcion" as sus
participant ":Factura" as factura
participant ":Administrador" as admin
participant ":Documento" as doc
participant ":Notificacion" as notificacion

Usuario -> client: 1.Seleccionar cliente
client --> Usuario: Datos del cliente

Usuario -> lector: 2.crearfacturaManual(factura)
lector -> factura: 3.calcular()
factura --> lector: Importes calculados

lector -> factura: 4.generarPdfEstandar()
factura --> lector: PDF generado

alt Datos fiscales incompletos
    lector --> Usuario: Mostrar errores de validación

else Datos correctos

    alt Requiere aprobación
        Usuario -> admin: Solicitar aprobación
        admin -> admin: 5.aprobarfactura(factura)
        admin --> Usuario: Aprobación registrada
    end

    Usuario -> factura: 6.Confirmar emisión
    factura -> factura: 7.generarPdfEstandar()
    factura -> doc: 8.verificarIntegridad(bytes)
    doc --> factura: Resultado de integridad

    factura -> factura: 9.enviarPorEmail()

    alt Envío correcto
        factura -> notificacion: 10.estaEntregada()
        notificacion --> factura: Resultado de entrega

    else Error de envío
        factura -> factura: 11.registrarIncidenciaEntrega()
    end

end

@enduml
