@startuml
title CU-12: Emitir y enviar una factura o factura rectificativa
autonumber

actor "Administrador / Lector (persona)" as persona
participant ":Lector" as lector
participant ":Administrador" as admin
participant ":Factura" as factura
participant ":Documento" as doc

persona -> lector : consultarCliente(Cliente)
activate lector
lector --> persona : Cliente

persona -> lector : crearFacturaManual(Factura)
lector --> factura ** : crear Factura (borrador, o rectificativa vinculada a la original)
activate factura
factura -> factura : calcular()

alt #Pink Datos fiscales incompletos (extensión 3a)
    factura --> lector : emisión bloqueada, errores indicados
    lector --> persona : errores de validación
else #LightGreen Datos fiscales completos
    opt #LightBlue Importe anómalo o condiciones que requieren aprobación (4a)
        persona -> admin : aprobarFactura(Factura)
        activate admin
        admin --> persona : aprobación registrada
        deactivate admin
    end

    factura -> factura : generarPdfEstandar()
    factura --> doc ** : crear Documento (PDF definitivo)
    doc -> doc : verificarIntegridad(bytes)
    factura -> factura : enviarPorEmail()

    alt #LightBlue Envío correcto
        factura -> factura : actualizarEstadoCobro()
        factura --> lector : factura emitida y enviada
    else #Pink Falla el envío (extensión 7a)
        factura -> factura : registrarIncidenciaEntrega()
        factura --> lector : factura conservada, incidencia abierta
    end
    lector --> persona : resultado del envío
end
deactivate factura
deactivate lector
@enduml
