@startuml
title TurbineH - Obtener PDF de una factura de un cliente

actor Lector
participant "Cliente" as Cliente
participant "Factura" as Factura

Lector -> Lector: consultarCliente(cliente: Cliente)
Lector -> Cliente: facturas
Cliente --> Lector: facturas [0..*]
alt #Pink el cliente tiene facturas
    Lector -> Factura: generarPdfEstandar()
    Factura --> Lector: urlPdf: String
else #LightGreen sin facturas
    Lector --> Lector: sin resultados
end
@enduml
