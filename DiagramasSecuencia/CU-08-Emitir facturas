@startuml

title CU-08: Emitir orden de cobro / Envío de factura automática

actor "Reloj del sistema" as reloj

participant ":Suscripción" as sus
participant ":Factura" as factura

reloj --> sus : 1. comprobarFechaEmision

activate sus

loop Por cada suscripción activa cuya fecha de emisión ha llegado

    sus --> factura : 2. crearFactura 
    activate factura

    factura -> factura : 3. calcular()
    factura --> sus : Importe calculado

    factura -> factura : 4. generarPdfEstandar()
    factura --> sus : PDF generado

    factura -> factura : 7. enviarPorEmail()
    factura --> sus : Confirmación de envío

    factura -> factura : 8. actualizarEstadoCobro()

    deactivate factura

end

deactivate sus

@enduml

