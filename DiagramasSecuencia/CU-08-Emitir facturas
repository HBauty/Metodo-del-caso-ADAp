@startuml
title CU-08: Emitir orden de cobro / Envío de factura automática
autonumber

actor "Proceso interno de facturación" as proceso
participant ":Factura" as factura
participant ":Documento" as doc

loop #Lightblue Día 1 de cada mes, por cada suscripción activa
    proceso --> factura ** : crearFactura
    activate factura

    factura -> factura : calcular()
    factura -> factura : generarPdfEstandar()
    factura --> doc ** : crearDocumento
    factura -> factura : enviarPorEmail()

    alt #lightgreen Envío correcto
        factura -> factura : actualizarEstadoCobro()
    else #lightpink  Fallo de envío
        factura -> factura : registrarIncidenciaEntrega()
    end

    deactivate factura
end
@enduml
