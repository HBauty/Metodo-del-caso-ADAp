@startuml
title TurbineH - Generar comprobante de una factura

actor Administrador as Admin
participant "Cliente" as Cliente
participant "Factura" as Factura

Admin -> Admin: consultarCliente(cliente: Cliente)
alt cliente existe y la factura está en su asociación "facturas"
    Admin -> Cliente: facturas
    Cliente --> Admin: facturas [0..*]
    Admin -> Factura: generarPdfEstandar()
    Factura --> Admin: urlPdf: String
else no existe el cliente o la factura no le pertenece
    Admin --> Admin: error
end
@enduml
