
@startuml
title CU-06: Consultar y gestionar fichas de clientes e historial

actor ":Lector" as lector
participant ":Cliente" as cliente

lector -> cliente : 1. consultarCliente(Cliente)
activate cliente
cliente --> lector : Cliente

lector -> cliente : 2. editarCliente(Cliente)

alt No hay conflicto de concurrencia
    cliente --> lector : modificación aceptada
else Hay conflicto de concurrencia
    cliente --> lector : aviso de conflicto
    lector -> cliente : recargar datos actuales
    cliente --> lector : datos actualizados
end
deactivate cliente

@enduml
