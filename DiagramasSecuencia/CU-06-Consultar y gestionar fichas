@startuml
title CU-06: Consultar y editar fichas de clientes
autonumber

actor "Lector (persona)" as persona
participant ":Lector" as lector

persona -> lector : consultarCliente(Cliente)
activate lector
lector --> persona : Cliente
deactivate lector

persona -> lector : editarCliente(Cliente)
activate lector

alt Sin conflicto de concurrencia
    lector --> persona : ficha actualizada
else Conflicto de concurrencia
    lector --> persona : aviso de conflicto
    persona -> lector : consultarCliente(Cliente)
    lector --> persona : Cliente (datos actuales)
end
deactivate lector
@enduml
