@startuml TurbineH_clases
' Vista general del mismo modelo desarrollado en las vistas de detalle.
' Solo se muestran clases centrales y operaciones representativas.
' UTF-8. Vista autocontenida: no necesita includes ni archivos externos.
top to bottom direction
skinparam backgroundColor #FFFFFF
skinparam shadowing false
skinparam defaultFontName Arial
skinparam defaultFontSize 13
skinparam classAttributeIconSize 0
skinparam nodesep 55
skinparam ranksep 65
skinparam ArrowColor #64748B
skinparam class {
  BackgroundColor #F8FAFC
  BorderColor #334155
  BackgroundColor<<referencia>> #E2E8F0
  BackgroundColor<<servicio>> #DBEAFE
  BackgroundColor<<control>> #E0E7FF
  BackgroundColor<<adaptador>> #DCFCE7
  BackgroundColor<<inmutable>> #FEF3C7
}
hide empty members

title TurbineH - Vista general de clases

class Usuario #DBEAFE {
  - id: UUID
  - nombre: String 
  - contraseña: String
  - email: String
  - activo: Boolean
  + autenticar(): Boolean
  + desactivar(): void
}
class Lector #DBEAFE {
 - clientes: List [Cliente]
 + crearCliente(Cliente)    
 + consultarCliente(Cliente)        
 + editarCliente(Cliente)            
 + borrarCliente(Cliente)       
 + crearFacturaManual(Factura)      
 + revisarDiferenciaPago(Factura)
}
class Administrador #DBEAFE {
- Lectores: List[Lector]
+ registrarLector(Lector)  
+ asignarCliente(Lector, Cliente)     
+ eliminarCliente(Lector,Cliente)    
+ aprobarFactura(Factura) 
+ consultarInformes() 
}
class Superadministrador #DBEAFE {
- admins: List[Administrador]
+ crearAdministrador()
+ modificarAdmin()      
+ modificarConfigSistema() 
+ configurarRecordatorios() 
}
class Cliente #DCFCE7 {
  - id: UUID                                                                 
 - nombreEmpresa: String                                                    
 - nombreComercial: String                                                  
 - razonSocial: String                                                      
 - pais: String                                                             
 - moneda: String                                                           
 - nifOIdentificadorInternacional: String            
 - direccion: String                                                        
 - datosContacto: String                                                    
 - fechaContratacion: Date                                                  
 - suscripción: Suscripción                                           
 - condicionesPagoParticulares: String                                      
 - estadoFicha: EstadoFicha {ACTIVO, PAUSADO, BAJA_LÓGICA} 
 - etiquetas: List<String>                                            
 - lectorAsignadoId: UUID                                                  
  + asociarDocumentoExterno(doc): Void                              
  + pausarSuscripción(motivo, fechaIni, fechaFin): Void (FR6)                
  + tramitarBaja(): Void                                              
  + reactivarFicha(): Void                                                         
  + agregarEtiqueta(etiqueta): Void 
}
class Suscripción #FFEDD5 {
  - cuotaMensualAcordada: Decimal
  - estado: EstadoSuscripcion
  - proximaEmision: Date [0..1]
  - rangoAnualDesde: Decimal
  - rangoAnualHasta: Decimal [0..1]
  + pausar(motivo: String, inicio: Date, retorno: Date [0..1]): void
  + cancelar(fecha: DateTime): void
}

class RevisionAnual #FFEDD5 {
  - suscripción: Suscripción
  - cuotaPropuesta: Decimal
  - efectivaDesde: Date
  - aprobada: Boolean
  + resolver(actor: Usuario, motivo: String): void
}
class Factura #FCE7F3 {
  - id: UUID       
  - facturaOrigen: UUID                                                          
  - numeroFactura: String                   
  - fechaEmision: Date                                                        
  - fechaVencimiento: Date                                                   
  - tipoFactura: TipoFactura {RECURRENTE, PUNTUAL, PROPORCIONAL}             
  - estadoFactura: EstadoFactura {BORRADOR, EMITIDA, PAGADA, DIFERENCIA_PENDIENTE, SEGUIMIENTO_PAUSADO}
  - subtotal: Decimal                                                 
  - porcentajeIVA: Decimal                                             
 - importeIVA: Decimal                                
- importeTotal: Decimal                                             
- urlPdfAlmacenado: String                                                 
- hashPdfSha256: String 
  + calcular(): Void                                                                         
  + generarPdfEstandar(): String             
  + enviarPorEmail(): Boolean                                         
  + pausarSeguimiento(motivoInterno, fechaLimite): Void               
  + registrarIncidenciaEntrega(): Void 
  + actualizarEstadoCobro(): void
}

class MovimientoPago #FCE7F3 {
  - idExterno: String
  - importe: Decimal
  - pasarela: String
  - pagado: Boolean
  + conectarPasarela(): Boolean
  + compararImporte(): Decimal
}
class Documento #FEF3C7 {
  - tipo: TipoDocumento
  - contenido: String
  - sha256: String
  + verificarIntegridad(bytes: Binary): Boolean
}
class Notificación #EDE9FE {
  - tipo: String
  - texto: String
  + estaEntregada(): Boolean
}
class Incidencia #EDE9FE {
  - pago: MovimientoPago
  - proximoReintento: DateTime [0..1]
  - resueltaEn: DateTime [0..1]
  - texto: String 
  + resolver(): void
}

Usuario "1" <-- "1..*" Lector : hereda de
Administrador "1..*" --> "1..*" Lector : hereda de
Superadministrador "1" --> "1" Administrador : hereda de
Cliente "1" -- "0..*" Suscripción : acuerdos
Cliente "1" -- "0..*" Factura : facturas
Suscripción "1" -- "0..*" RevisionAnual : revisión del precio
Suscripción "0..1" <-- "0..*" Factura : origen recurrente
Factura "0..*" --> "0..1" Factura : original rectificada
Factura "0..1" <-- "0..*" MovimientoPago : cobros individuales
Factura "0..1" --> "0..1" Documento : PDF definitivo
Suscripción "0..*" -- "0..*" Documento : contratos
Notificación "0..*" -- "1..*" Factura : comunica
Notificación "1" -- "0..*" Incidencia : fallos confirmados



note bottom of Factura
  Emitida: contenido y PDF inmutables.
  Correcciones mediante rectificativa vinculada.
  Emisión, cobro y seguimiento son independientes.
end note

@enduml
