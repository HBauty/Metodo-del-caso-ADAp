@startuml TurbineH_ER_01_Usuarios_COMPLETO

top to bottom direction
skinparam backgroundColor #FFFFFF
skinparam shadowing false
skinparam linetype ortho
skinparam defaultFontName Arial
skinparam defaultFontSize 12
skinparam nodesep 42
skinparam ranksep 56
skinparam ArrowColor #64748B
skinparam entity {
  BorderColor #475569
  FontColor #0F172A
}
skinparam package {
  BorderColor #CBD5E1
  FontColor #334155
}
hide circle
hide empty members
title TurbineH - Modelo Físico 1/2: Usuarios, Roles y Permisos

package "Identidad" #EFF6FF {
  entity "ROL" as ROL #DBEAFE {
    * id_rol: UUID <<PK>>
    --
    * nombre: VARCHAR(50) <<UK>>
      descripcion: TEXT [NULL]
      id_rol_padre: UUID <<FK>> [NULL]
  }

  entity "USUARIO" as USUARIO #DBEAFE {
    * id_usuario: UUID <<PK>>
    --
      id_rol: UUID <<FK>> [NULL]
    * nombre: VARCHAR(150)
    * email_corporativo: VARCHAR(255) <<UK>>
    * contrasena_hash: VARCHAR(255)
    * estado_cuenta: ENUM('PENDIENTE', 'ACTIVA', 'SUSPENDIDA', 'BAJA')
    * fecha_registro: DATETIME
  }
}

package "Autorización por roles" #EFF6FF {
  entity "PERMISO" as PERMISO #DBEAFE {
    * id_permiso: UUID <<PK>>
    --
    * codigo: VARCHAR(100) <<UK>>
      descripcion: VARCHAR(255) [NULL]
    * modulo: VARCHAR(50)
    * activo: BOOLEAN
  }

  entity "ROL_PERMISO" as ROL_PERMISO #DBEAFE {
    * id_rol: UUID <<PK, FK>>
    * id_permiso: UUID <<PK, FK>>
  }
}

package "Cartera y asignaciones" #F0FDF4 {
  entity "ASIGNACION_CLIENTE" as ASIGNACION_CLIENTE #DCFCE7 {
    * id_usuario: UUID <<PK, FK>>
    * id_cliente: UUID <<PK, FK>>
    --
    * asignado_por: UUID <<FK>>
    * fecha_asignacion: DATETIME
    * activa: BOOLEAN
  }
}

package "Trazabilidad y ajustes" #F8FAFC {
  entity "AUDITORIA" as AUDITORIA #E2E8F0 {
    * id_evento: UUID <<PK>>
    --
      id_usuario: UUID <<FK>> [NULL]
    * fecha_evento: DATETIME
    * entidad_afectada: VARCHAR(100)
    * entidad_id: UUID
    * accion: VARCHAR(100)
    * resultado: VARCHAR(50)
      cambios_json: JSON [NULL]
      hash_anterior: CHAR(64) [NULL]
    * hash_evento: CHAR(64)
  }

  entity "CONFIGURACION_SISTEMA" as CONFIGURACION #E2E8F0 {
    * id_configuracion: UUID <<PK>>
    --
    * clave: VARCHAR(100) <<UK>>
    * valor_json: JSON
    * fecha_modificacion: DATETIME
    * modificada_por: UUID <<FK>>
  }
}

' Referencia externa a la tabla CLIENTE definida en el Modelo Físico 2/2
entity "CLIENTE <<externa ER 2>>" as CLIENTE #F1F5F9 {
  * id_cliente: UUID <<PK>>
  --
    id_lector_asignado: UUID <<FK>> [NULL]
}

' Relaciones y claves foráneas
ROL |o--o{ USUARIO : tiene asignado
ROL |o--o{ ROL : hereda de (id_rol_padre)
ROL ||--o{ ROL_PERMISO : posee
PERMISO ||--o{ ROL_PERMISO : habilita
USUARIO ||--o{ ASIGNACION_CLIENTE : accede a (id_usuario)
USUARIO ||--o{ ASIGNACION_CLIENTE : asignado por (asignado_por)
CLIENTE ||--o{ ASIGNACION_CLIENTE : cartera asignada
USUARIO |o--o{ CLIENTE : lector responsable
USUARIO |o--o{ AUDITORIA : genera
USUARIO ||--o{ CONFIGURACION : modifica

legend bottom
  <b>Convenciones del Modelo Físico (SGBD):</b>
  - <b>*</b> indica atributo obligatorio (NOT NULL); <b>[NULL]</b> indica atributo opcional.
  - <b><<PK>></b> Clave Primaria | <b><<FK>></b> Clave Foránea | <b><<UK>></b> Restricción Única.
  - <b>CLIENTE <<externa ER 2>></b>: Tabla completa definida en el diagrama 2/2; referenciada aquí para integridad de FKs.
endlegend

@enduml
